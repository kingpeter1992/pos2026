{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "peace-app": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              {
                "glob": "**/*",
                "input": "public",
                "output": "/"
              }
            ],
            "styles": [
              "src/material-theme.scss",
              "src/styles.css",
              "src/assets/cooladmin/css/font-face.css",
              "src/assets/cooladmin/vendor/mdi-font/css/material-design-iconic-font.min.css",
              "src/assets/cooladmin/vendor/bootstrap-5.3.8.min.css",
              "src/assets/cooladmin/css/aos.css",
              "src/assets/cooladmin/vendor/css-hamburgers/hamburgers.min.css",
              "src/assets/cooladmin/css/swiper-bundle-12.0.3.min.css",
              "src/assets/cooladmin/vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.css",
              "src/assets/cooladmin/css/theme.css",
              "node_modules/bootstrap/dist/css/bootstrap.min.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.min.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeicons/primeicons.css",
              "node_modules/primeicons/primeicons.css"
            ],
            "scripts": [
              "src/assets/cooladmin/js/vanilla-utils.js",
              "src/assets/cooladmin/vendor/bootstrap-5.3.8.bundle.min.js",
              "src/assets/cooladmin/vendor/perfect-scrollbar/perfect-scrollbar-1.5.6.min.js",
              "src/assets/cooladmin/vendor/chartjs/chart.umd.js-4.5.1.min.js",
              "src/assets/cooladmin/js/bootstrap5-init.js",
              "src/assets/cooladmin/js/main-vanilla.js",
              "src/assets/cooladmin/js/swiper-bundle-12.0.3.min.js",
              "src/assets/cooladmin/js/aos.js",
              "src/assets/cooladmin/js/modern-plugins.js",
              "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js"
            ]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/environnement/environment.ts",
                  "with": "src/environnement/environment.prod.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "3mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "20kb"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "peace-app:build:production"
            },
            "development": {
              "buildTarget": "peace-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
